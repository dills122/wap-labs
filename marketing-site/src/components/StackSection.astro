---
const architectureLayers = [
  {
    number: '01',
    name: 'Gateway',
    owner: 'Kannel + deployment',
    detail: 'Bridges connectionless WAP traffic to allowlisted first-party content. Public access remains gated.'
  },
  {
    number: '02',
    name: 'Transport',
    owner: 'Lowband',
    detail: 'Owns constrained fetch, WSP/WTP behavior, response limits, and WBXML decode.'
  },
  {
    number: '03',
    name: 'Engine',
    owner: 'WaveNav',
    detail: 'Owns deterministic deck/card navigation, focus, WML runtime behavior, and presentation frames.'
  },
  {
    number: '04',
    name: 'Browser',
    owner: 'Waves',
    detail: 'Hosts the handset, routes input, presents recovery, and exposes desktop diagnostics.'
  }
];
---

<section class="stack-section section-block" id="stack" aria-labelledby="stack-title">
  <div class="section-heading" data-reveal>
    <h2 id="stack-title">Where does the authenticity live?</h2>
    <p>In explicit boundaries. Each layer carries one kind of truth into the desktop session.</p>
  </div>

  <ol class="architecture-list" aria-label="Waves architecture layers">
    {
      architectureLayers.map((layer, index) => (
        <li data-reveal style={`--reveal-order: ${index}`}>
          <span class="architecture-number">{layer.number}</span>
          <div>
            <h3>{layer.name}</h3>
            <p class="architecture-owner">{layer.owner}</p>
          </div>
          <p class="architecture-detail">{layer.detail}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .architecture-list {
    border-top: var(--rule-thick);
    list-style: none;
  }

  .architecture-list li {
    display: grid;
    grid-template-columns: 3.5rem minmax(9rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-md);
    min-height: 7rem;
    align-items: center;
    padding-block: var(--space-md);
    border-bottom: var(--rule-thin);
  }

  .architecture-number {
    color: var(--color-signal-dark);
    font: 900 var(--text-lg)/1 var(--font-display);
  }

  .architecture-owner {
    margin-top: var(--space-2xs);
    color: var(--color-terminal);
    font: 700 var(--text-xs)/1.3 var(--font-mono);
    text-transform: uppercase;
  }

  .architecture-detail {
    max-width: 62ch;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  @media (max-width: 62rem) {
    .architecture-list li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .architecture-detail {
      grid-column: 2;
    }
  }

  @media (max-width: 28rem) {
    .architecture-list li {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
