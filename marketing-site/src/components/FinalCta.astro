---
---

<section class="final-cta" aria-labelledby="cta-title">
  <div class="final-cta-copy" data-reveal>
    <p class="status-label">Web simulator available</p>
    <h2 id="cta-title">Preview the work—not a desktop release.</h2>
    <p>
      The web simulator runs the real WaveNav WASM engine with bundled examples and no network
      access. Use it to explore current behavior, then follow the active release evidence in Atlas.
    </p>
  </div>
  <div class="final-cta-actions" data-reveal>
    <a class="button button-light" href="./simulator/">
      <span>Open web simulator</span><span aria-hidden="true">→</span>
    </a>
    <a class="text-link" href="./atlas/docs/waves/prd-waves-desktop-application-completion">
      Read the release plan →
    </a>
    <a class="text-link" href="https://github.com/dills122/wap-labs/tree/main/browser">
      Browse current source ↗
    </a>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: end;
    overflow: hidden;
    margin-block: var(--space-xl);
    padding: clamp(var(--space-md), 4vw, var(--space-xl));
    color: var(--color-paper);
    background: var(--color-terminal);
    border: var(--rule-thick);
    box-shadow: var(--shadow-capture);
  }

  .final-cta::after {
    position: absolute;
    inset-block-start: -1rem;
    inset-inline-end: var(--space-lg);
    content: 'W';
    color: var(--color-terminal-watermark);
    font: 900 clamp(8rem, 16vw, 15rem)/0.8 var(--font-display);
    pointer-events: none;
  }

  .final-cta .status-label {
    color: var(--color-terminal-accent);
  }

  .final-cta h2 {
    position: relative;
    z-index: 1;
    max-width: 16ch;
  }

  .final-cta-copy > p:last-child {
    position: relative;
    z-index: 1;
    max-width: 65ch;
    margin-top: var(--space-md);
    color: var(--color-terminal-copy);
    line-height: 1.6;
  }

  .final-cta-actions {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 15rem;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .text-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-3xs);
    font: 700 var(--text-xs)/1 var(--font-mono);
    text-underline-offset: 0.35rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .text-link:hover {
    color: var(--color-terminal-accent);
  }

  @media (max-width: 58rem) {
    .final-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .final-cta-actions {
      min-width: 0;
    }
  }

  @media (max-width: 36rem) {
    .final-cta {
      margin-inline-end: 0.35rem;
      box-shadow: 0.35rem 0.35rem 0 var(--color-rule);
    }
  }
</style>
