---
const signals = [
  ['Current main', 'Local + network paths'],
  ['Current main', 'Canvas + safe app state'],
  ['Release work', 'Recovery + Home + packaging'],
  ['Public lab', 'Private and gated']
];
---

<aside class="signal-strip" aria-label="Current project status">
  {
    signals.map(([label, detail]) => (
      <p>
        <span>{label}</span>
        <strong>{detail}</strong>
      </p>
    ))
  }
</aside>

<style>
  .signal-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    color: var(--color-paper);
    background: var(--color-terminal-dark);
    border-bottom: var(--rule-thick);
  }

  .signal-strip p {
    display: grid;
    min-height: 5rem;
    gap: var(--space-2xs);
    align-content: center;
    padding: var(--space-sm) var(--space-md);
    border-inline-end: 1px solid var(--color-ink-soft);
  }

  .signal-strip p:last-child {
    border-inline-end: 0;
  }

  .signal-strip span {
    color: var(--color-terminal-accent);
    font: 700 var(--text-xs)/1 var(--font-mono);
    text-transform: uppercase;
  }

  .signal-strip strong {
    font: 700 var(--text-sm)/1.3 var(--font-body);
  }

  @media (max-width: 54rem) {
    .signal-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .signal-strip p:nth-child(2) {
      border-inline-end: 0;
    }

    .signal-strip p:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-ink-soft);
    }
  }

  @media (max-width: 26rem) {
    .signal-strip {
      grid-template-columns: 1fr;
    }

    .signal-strip p,
    .signal-strip p:nth-child(2) {
      min-height: 4.25rem;
      border-inline-end: 0;
      border-bottom: 1px solid var(--color-ink-soft);
    }

    .signal-strip p:last-child {
      border-bottom: 0;
    }
  }
</style>
