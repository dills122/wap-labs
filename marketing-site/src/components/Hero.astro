---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-topline">
    <p class="eyebrow">Waves desktop browser</p>
    <p class="hero-state">Initial pre-release path · no release date announced</p>
  </div>

  <h1 id="hero-title">Waves is moving toward its first pre-release.</h1>

  <div class="hero-foot">
    <p class="hero-note">
      Not available yet. The runtime, transport, native shell, and testing foundations are real;
      the release work is still landing.
    </p>
    <span aria-hidden="true">Scroll to tune in ↓</span>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100dvh - 5.5rem);
    grid-template-rows: auto 1fr auto;
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
    border-bottom: var(--rule-thick);
  }

  .hero-topline,
  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .hero-state,
  .hero-foot > span {
    color: var(--color-ink-soft);
    font: 700 var(--text-xs)/1.4 var(--font-mono);
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    align-self: center;
    font-size: var(--text-display);
    line-height: 1;
  }

  .hero-note {
    max-width: 62ch;
    color: var(--color-ink-soft);
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    font-weight: 600;
    line-height: 1.45;
  }

  .hero-foot > span {
    flex: 0 0 auto;
    color: var(--color-signal-dark);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: min(46rem, calc(100dvh - 5.5rem));
      padding-block-start: var(--space-md);
    }

    .hero-topline,
    .hero-foot {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-state {
      max-width: 31ch;
    }

    .hero-foot > span {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    h1 {
      font-size: clamp(3.25rem, 17.5vw, 4.2rem);
    }
  }
</style>
