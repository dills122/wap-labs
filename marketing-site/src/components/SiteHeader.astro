---
---

<header class="masthead" aria-label="Primary navigation">
  <a class="brand" href="./" aria-label="WAP Labs home">
    <span class="brand-mark" aria-hidden="true">W</span>
    <span>
      <strong>WAP Labs</strong>
      <small>Waves desktop browser</small>
    </span>
  </a>

  <div class="masthead-status" aria-label="Release status">
    <span class="status-dot" aria-hidden="true"></span>
    <span>Pre-release in progress</span>
  </div>

  <nav class="site-nav" aria-label="Release path">
    <a href="#release-path">See the release path <span aria-hidden="true">↓</span></a>
  </nav>
</header>

<style>
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-md);
    min-height: 5.5rem;
    align-items: center;
    border-bottom: var(--rule-thick);
  }

  .masthead-status {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    color: var(--color-ink-soft);
    font: 700 var(--text-xs)/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.6rem;
    height: 0.6rem;
    flex: 0 0 auto;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border: 1px solid var(--color-rule);
  }

  .site-nav {
    justify-self: end;
  }

  .site-nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-xs);
    padding-inline: var(--space-sm);
    color: var(--color-paper);
    background: var(--color-terminal);
    border: 2px solid var(--color-rule);
    box-shadow: 2px 2px 0 var(--color-rule);
    font: 700 var(--text-xs)/1 var(--font-mono);
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .site-nav a:hover {
    background: var(--color-signal-dark);
    box-shadow: 4px 4px 0 var(--color-rule);
    transform: translate(-2px, -2px);
  }

  .site-nav a:active {
    box-shadow: 1px 1px 0 var(--color-rule);
    transform: translate(1px, 1px);
  }

  @media (max-width: 48rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .masthead-status {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .site-nav a {
      width: 2.75rem;
      justify-content: center;
      padding: 0;
      font-size: 0;
    }

    .site-nav a span {
      font-size: var(--text-md);
    }
  }
</style>
