---
const capabilities = [
  ['Load', 'Run bundled local examples through the ordinary engine path.'],
  ['Browse', 'Use the native transport path for HTTP, WAP gateway, and linked-deck navigation.'],
  ['Interact', 'Drive focus, text/select editing, forms, timers, and softkey-style actions.'],
  ['Recover', 'Keep navigation state stable when a request fails or an external intent is blocked.'],
  ['Inspect', 'Open bounded session, transport, runtime, source, and timeline views.'],
  ['Repeat', 'Exercise deterministic stories and parity-critical behavior without a mock runtime.']
];
---

<section class="capabilities section-block" aria-labelledby="capabilities-title">
  <div class="section-heading" data-reveal>
    <h2 id="capabilities-title">What can the current development build exercise?</h2>
    <p>These foundations are on current main. They are not a packaged or downloadable pre-release.</p>
  </div>

  <div class="capabilities-body">
    <ol class="capability-list">
      {
        capabilities.map(([title, detail], index) => (
          <li data-reveal style={`--reveal-order: ${index}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{detail}</p>
          </li>
        ))
      }
    </ol>

    <figure class="inspector-capture" data-reveal>
      <img
        src="./waves-browser-inspector.webp"
        alt="Current Waves development build with the Developer Tools drawer open beside a WML handset view"
        width="1024"
        height="768"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Current Developer Tools view. Host attachment and the broader WAP Inspector remain release-path work.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .capabilities-body {
    min-width: 0;
  }

  .capability-list {
    border-top: var(--rule-thick);
    list-style: none;
  }

  .capability-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(7rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--space-sm);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-bottom: var(--rule-thin);
  }

  .capability-list li > span {
    color: var(--color-signal-dark);
    font: 700 var(--text-xs)/1 var(--font-mono);
  }

  .capability-list p {
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .inspector-capture {
    min-width: 0;
    margin-top: var(--space-xl);
    background: var(--color-paper-strong);
    border: var(--rule-thick);
  }

  .inspector-capture img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .inspector-capture figcaption {
    padding: var(--space-xs) var(--space-sm);
    color: var(--color-ink-soft);
    background: var(--color-canvas);
    border-top: var(--rule-thin);
    font: 700 var(--text-xs)/1.45 var(--font-mono);
  }

  @media (max-width: 36rem) {
    .capability-list li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .capability-list p {
      grid-column: 2;
    }
  }
</style>
