---
const capabilities = [
  ['Browse', 'Open bundled examples and follow HTTP, WAP gateway, and linked-deck paths.'],
  ['Interact', 'Drive focus, text/select editing, forms, timers, and softkey-style actions.'],
  ['Inspect', 'Use current Developer Tools while the broader WAP Inspector remains release work.'],
  ['Repeat', 'Run deterministic stories and parity-critical checks against the real runtime.']
];
---

<section class="capabilities section-block" aria-labelledby="capabilities-title">
  <div class="section-heading" data-reveal>
    <p class="section-number">03 / In practice</p>
    <h2 id="capabilities-title">A browser,<br />not just a harness.</h2>
  </div>
  <div class="capabilities-detail">
    <ol class="capability-list">
      {
        capabilities.map(([title, detail], index) => (
          <li data-reveal style={`--reveal-order: ${index}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{detail}</p>
          </li>
        ))
      }
    </ol>

    <figure class="capability-capture" data-reveal>
      <img
        src="./waves-browser-inspector.webp"
        alt="Current Waves development build with Developer Tools open beside the handset view"
        width="1024"
        height="768"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Current Developer Tools overview. Host attachment and the full WAP Inspector remain on the
        release path.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .capabilities-detail {
    min-width: 0;
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--rule-thick);
    border-left: var(--rule-thin);
    list-style: none;
  }

  .capability-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1rem;
    min-height: 11rem;
    align-content: start;
    padding: var(--space-4);
    border-right: var(--rule-thin);
    border-bottom: var(--rule-thin);
  }

  .capability-list li > span {
    grid-row: span 2;
    color: var(--color-signal-dark);
    font: 700 0.7rem/1 var(--font-mono);
  }

  .capability-list p {
    max-width: 25rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .capability-capture {
    margin-top: var(--space-4);
    border: var(--rule-thick);
    background: var(--color-paper);
  }

  .capability-capture img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .capability-capture figcaption {
    padding: 0.75rem 1rem;
    border-top: var(--rule-thin);
    color: var(--color-ink-soft);
    font: 700 0.68rem/1.45 var(--font-mono);
  }

  @media (max-width: 50rem) {
    .capability-list {
      grid-template-columns: 1fr;
    }

    .capability-list li {
      min-height: 9rem;
    }
  }

  @media (max-width: 36rem) {
    .capability-list li {
      padding: 1.2rem 1rem;
    }
  }
</style>
