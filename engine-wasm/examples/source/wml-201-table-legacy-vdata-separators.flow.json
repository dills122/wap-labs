{
  "version": 1,
  "example": "wml201TableLegacyVdataSeparators",
  "flows": [
    {
      "id": "legacy-table-fallback-wraps-resolved-variable-cell",
      "title": "An overwide table wraps a resolved variable with the merged cell separators",
      "target": "waves-browser",
      "setup": { "runMode": "local" },
      "workItems": ["WML-201"],
      "specItems": ["WML-CL-TABLE-LONG-ROW-AGGREGATION"],
      "initial": {
        "state": { "activeCardId": "main", "focusedLinkIndex": 0 },
        "render": { "textAtRows": [{ "row": 0, "text": "Show table" }] }
      },
      "steps": [
        {
          "action": { "type": "key", "key": "enter" },
          "expect": {
            "state": { "activeCardId": "table", "externalNavigationIntent": null },
            "render": {
              "textAtRows": [
                { "row": 0, "text": "Red Fox End Up" },
                { "row": 1, "text": "Sunset" }
              ]
            },
            "traceKinds": ["KEY", "ACTION_FRAGMENT"]
          }
        }
      ]
    }
  ]
}
