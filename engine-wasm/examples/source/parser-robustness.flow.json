{
  "version": 1,
  "example": "parserRobustness",
  "flows": [
    {
      "id": "unsupported-tag-ignored-and-navigable",
      "title": "Unsupported node is ignored while valid cards remain navigable",
      "workItems": ["A1-01", "A1-03"],
      "specItems": ["WML-R-001", "WML-R-020"],
      "initial": {
        "state": { "activeCardId": "home", "focusedLinkIndex": 0 }
      },
      "steps": [
        {
          "action": { "type": "key", "key": "enter" },
          "expect": {
            "state": { "activeCardId": "next", "focusedLinkIndex": 0 },
            "traceKinds": ["KEY", "ACTION_FRAGMENT"]
          }
        },
        {
          "action": { "type": "key", "key": "enter" },
          "expect": {
            "state": { "activeCardId": "home", "focusedLinkIndex": 0 },
            "traceKinds": ["KEY", "ACTION_FRAGMENT"]
          }
        }
      ]
    }
  ]
}
