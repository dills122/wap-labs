{
  "version": 1,
  "example": "wml201TableLongRowAggregation",
  "flows": [
    {
      "id": "long-table-rows-and-link-activation",
      "title": "Long rows keep spaces and independent links in the final column",
      "target": "waves-browser",
      "setup": { "runMode": "local" },
      "workItems": ["WML-201"],
      "specItems": ["WML-CL-TABLE-LONG-ROW-AGGREGATION"],
      "initial": {
        "state": { "activeCardId": "main", "focusedLinkIndex": 0 },
        "render": {
          "textAtRows": [
            { "row": 0, "text": "Before" },
            { "row": 2, "text": "WideBase" },
            { "row": 3, "text": "S" },
            { "row": 4, "text": "AFox Go End" },
            { "row": 6, "text": "Between" },
            { "row": 8, "text": "Up Go End" },
            { "row": 10, "text": "After" }
          ]
        }
      },
      "steps": [
        {
          "action": { "type": "key", "key": "down" },
          "expect": { "state": { "activeCardId": "main", "focusedLinkIndex": 1 } }
        },
        {
          "action": { "type": "key", "key": "enter" },
          "expect": {
            "state": { "activeCardId": "next", "externalNavigationIntent": null },
            "render": { "textAtRows": [{ "row": 0, "text": "Destination" }] },
            "traceKinds": ["KEY", "ACTION_FRAGMENT"]
          }
        }
      ]
    }
  ]
}
