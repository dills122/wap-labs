{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wap-labs.dev/schemas/effective-spec.schema.json",
  "title": "Project Atlas effective specification input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "generatedFrom",
    "governingConformanceDocument",
    "governingClassProfileDocument",
    "classProfileLedger",
    "strictTransportProfile",
    "graphStatus",
    "semantics",
    "summary",
    "families"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseId": {
      "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
    },
    "generatedFrom": {
      "$ref": "#/$defs/generatedFrom"
    },
    "governingConformanceDocument": {
      "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
    },
    "governingClassProfileDocument": {
      "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
    },
    "classProfileLedger": {
      "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
    },
    "strictTransportProfile": {
      "$ref": "#/$defs/strictTransportProfile"
    },
    "graphStatus": {
      "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveSequence", "proposedDocuments", "laterSpecifications"],
      "properties": {
        "effectiveSequence": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
        },
        "proposedDocuments": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
        },
        "laterSpecifications": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyCount", "byTargetDisposition"],
      "properties": {
        "familyCount": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/positiveInteger"
        },
        "byTargetDisposition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonNegativeInteger"
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "inputs"],
      "properties": {
        "generator": {
          "const": "spec-processing/scripts/generate-wap-effective-spec.mjs"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "classConformance",
            "ingestion",
            "externalDependencies",
            "externalIngestion"
          ],
          "properties": {
            "release": {
              "$ref": "#/$defs/releaseInput"
            },
            "classConformance": {
              "$ref": "#/$defs/classConformanceInput"
            },
            "ingestion": {
              "$ref": "#/$defs/ingestionInput"
            },
            "externalDependencies": {
              "$ref": "#/$defs/externalDependenciesInput"
            },
            "externalIngestion": {
              "$ref": "#/$defs/externalIngestionInput"
            }
          }
        }
      }
    },
    "releaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "spec-processing/source-manifests/wap-1.2.1-release.json"
        },
        "sha256": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
        }
      }
    },
    "classConformanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "spec-processing/source-manifests/wap-1.2.1-class-conformance.json"
        },
        "sha256": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
        }
      }
    },
    "ingestionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "spec-processing/source-manifests/wap-1.2.1-ingestion-status.json"
        },
        "sha256": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
        }
      }
    },
    "externalDependenciesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "spec-processing/source-manifests/wap-1.2.1-external-dependencies.json"
        },
        "sha256": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
        }
      }
    },
    "externalIngestionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "spec-processing/source-manifests/wap-1.2.1-external-ingestion-status.json"
        },
        "sha256": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
        }
      }
    },
    "strictTransportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "deviceRole", "deviceClass", "selectedBearer", "families"],
      "properties": {
        "profileId": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
        },
        "deviceRole": { "const": "client" },
        "deviceClass": { "const": "C" },
        "selectedBearer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "networkProtocol",
            "datagramProtocol",
            "sourceDocument",
            "sourceSection",
            "externalContext"
          ],
          "properties": {
            "id": { "const": "cdpd-ipv4" },
            "networkProtocol": { "const": "ipv4" },
            "datagramProtocol": { "const": "udp" },
            "sourceDocument": { "const": "WAP-200-WDP" },
            "sourceSection": { "const": "5.4.3" },
            "externalContext": { "const": "tiaeia-is-732-cdpd-set" }
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wdp", "wcmp", "wsp", "wtp"],
          "properties": {
            "wdp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selectedFeatureGroup", "selectedPath", "sourceDocuments"],
              "properties": {
                "selectedFeatureGroup": { "const": "WDP:MCF" },
                "selectedPath": { "const": "udp-over-ipv4" },
                "sourceDocuments": {
                  "const": ["WAP-200-WDP", "rfc-768", "rfc-791"]
                }
              }
            },
            "wcmp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selectedFeatureGroup",
                "selectedPath",
                "sourceDocument",
                "sourceSection",
                "normativeDependency",
                "generalWcmpDisposition"
              ],
              "properties": {
                "selectedFeatureGroup": { "const": "WCMP:MCF" },
                "selectedPath": { "const": "rfc-792-icmpv4" },
                "sourceDocument": { "const": "WAP-202-WCMP" },
                "sourceSection": { "const": "5.3" },
                "normativeDependency": { "const": "rfc-792" },
                "generalWcmpDisposition": {
                  "const": "capability-gated-non-ip-bearer"
                }
              }
            },
            "wsp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selectedFeatureGroup",
                "selectedPath",
                "sourceDocument",
                "connectionOrientedDisposition"
              ],
              "properties": {
                "selectedFeatureGroup": { "const": "WSP:MCF" },
                "selectedPath": { "const": "connectionless" },
                "sourceDocument": { "const": "WAP-203-WSP" },
                "connectionOrientedDisposition": {
                  "const": "conditional-capability"
                }
              }
            },
            "wtp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selected", "activationCondition"],
              "properties": {
                "selected": { "const": false },
                "activationCondition": {
                  "const": "connection-oriented-wsp-selected"
                }
              }
            }
          }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "title",
        "sourceClass",
        "targetDisposition",
        "ownerLayers",
        "completeness",
        "interpretationRule",
        "effectiveSequence",
        "baseDocuments",
        "sinDocuments",
        "historicalDocuments",
        "relationships",
        "scrExtraction",
        "successorEvidence",
        "documents"
      ],
      "properties": {
        "family": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
        },
        "title": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
        },
        "sourceClass": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sourceClass"
        },
        "targetDisposition": {
          "enum": [
            "historical-only",
            "optional-profile",
            "strict-baseline",
            "strict-conditional",
            "strict-supporting"
          ]
        },
        "ownerLayers": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/stringArray"
        },
        "completeness": {
          "enum": ["release-carried-sin-without-base", "release-member-chain-complete"]
        },
        "interpretationRule": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
        },
        "effectiveSequence": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifierArray"
        },
        "baseDocuments": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifierArray"
        },
        "sinDocuments": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifierArray"
        },
        "historicalDocuments": {
          "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifierArray"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "type"],
            "properties": {
              "from": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
              },
              "to": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
              },
              "type": { "enum": ["amended-by", "applied-before"] }
            }
          }
        },
        "scrExtraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "governingDocument", "note"],
          "properties": {
            "status": {
              "enum": ["line-item-ledger-complete-class-c-applied", "pending-line-item-ledger"]
            },
            "governingDocument": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
            },
            "governingClassProfileDocument": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
            },
            "ledger": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
            },
            "classProfileLedger": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
            },
            "selectedProfile": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
            },
            "selectedFeatureGroup": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
            },
            "applicability": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile", "family"],
              "properties": {
                "profile": { "const": "#/strictTransportProfile" },
                "family": {
                  "enum": [
                    "#/strictTransportProfile/families/wdp",
                    "#/strictTransportProfile/families/wcmp",
                    "#/strictTransportProfile/families/wsp"
                  ]
                }
              }
            },
            "note": {
              "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "successorEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentId", "role", "deltaStatus"],
            "properties": {
              "documentId": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
              },
              "role": { "const": "delta-evidence-only" },
              "deltaStatus": {
                "enum": [
                  "optional-media-delta-pending",
                  "pending",
                  "selected-profile-delta-complete"
                ]
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "filename",
              "documentRole",
              "publicationStatus",
              "publishedOn",
              "sha256",
              "localState"
            ],
            "properties": {
              "documentId": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/identifier"
              },
              "filename": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/nonEmptyString"
              },
              "documentRole": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/documentRole"
              },
              "publicationStatus": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/publicationStatus"
              },
              "publishedOn": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/date"
              },
              "sha256": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/sha256"
              },
              "localState": {
                "$ref": "https://wap-labs.dev/schemas/atlas-common.schema.json#/$defs/localState"
              }
            }
          }
        }
      }
    }
  }
}
